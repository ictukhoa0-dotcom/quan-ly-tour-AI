# Application mode; use HTTPS for production deployments
APP_ENV=development

# Backend environment (copy to backend/.env)
DATABASE_URL=sqlite:///./viettour.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-private-initial-admin-password
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
FRONTEND_ORIGIN=http://localhost:5173

# Optional frontend build setting (place in the project-root .env)
VITE_API_URL=http://localhost:8000/api

# Docker Compose deployment (use a URL-safe password with PostgreSQL)
POSTGRES_PASSWORD=replace-with-a-private-url-safe-password
